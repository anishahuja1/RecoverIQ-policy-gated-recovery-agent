# RecoverIQ Environment Variables
# Copy this file to .env and fill in values (all optional for demo)

# AI Mode (default: DEMO_MODE - no API calls needed)
# Set either of these to enable LIVE_AI_MODE
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Database (default: SQLite in backend directory)
# DATABASE_URL=sqlite:///./recoveriq.db

# Policy thresholds (optional overrides)
# HIGH_VALUE_THRESHOLD=25000.0
# MAX_RETRIES=3
# LOW_CONFIDENCE_THRESHOLD=0.6

# ──────────────────────────────────────────────────────────────
# FRONTEND (Vite) — only needed for deployed (non-local) builds
# ──────────────────────────────────────────────────────────────
# Leave blank for local dev (Vite proxy handles /api → localhost:8000).
# Set this in Vercel dashboard when deploying the frontend separately.
# VITE_API_URL=https://your-render-backend-url.onrender.com
